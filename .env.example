# KB증권 OpenAPI 포털에서 발급받은 값을 입력하세요.
# 이 파일을 .env로 복사해 사용하고, .env는 절대 공유하거나 Git에 올리지 마세요.
KB_OPENAPI_BASE_URL=https://developer.kbsec.com:32484
KB_OPENAPI_APP_KEY=
KB_OPENAPI_APP_SECRET=

# 토스증권 OpenAPI (WTS > Open API에서 발급)
# 토스증권 WTS의 허용 IP 관리에 이 컴퓨터의 공인 IP를 등록해야 합니다.
TOSSINVEST_OPENAPI_BASE_URL=https://openapi.tossinvest.com
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# NH투자증권(나무) NHPLUG Open API
# 실계좌는 api.nhplug.com, 모의계좌는 moapi.nhplug.com 주소를 사용합니다.
NHPLUG_BASE_URL=https://api.nhplug.com:8443
NHPLUG_AUTH_URL=https://api.nhplug.com:8443
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=

# USD/KRW 환율은 토스증권 OpenAPI에서 실시간으로 받아 저장합니다.
# 고정 환율은 입력하지 않습니다.
